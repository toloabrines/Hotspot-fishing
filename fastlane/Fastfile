# Hotspot Fishing — fastlane Fastfile
# Compila la app Capacitor en iOS y la sube a TestFlight desde un runner
# macOS de GitHub Actions, sin que necesites un Mac propio.
#
# Lanes:
#   - ios beta    → build + upload a TestFlight
#   - ios release → build + upload a App Store Connect (sin enviar a review)
#
# Variables de entorno esperadas (definidas como GitHub Secrets):
#   APPLE_TEAM_ID                 Apple Developer Team ID (10 chars)
#   IOS_BUNDLE_ID                 ej. app.lovable.hotspotfishing
#   APP_STORE_CONNECT_KEY_ID      Key ID de la API key de App Store Connect
#   APP_STORE_CONNECT_ISSUER_ID   Issuer ID de App Store Connect
#   APP_STORE_CONNECT_KEY_P8      Contenido completo del .p8 (multilínea)
#   IOS_DIST_CERT_P12_BASE64      Certificado distribución .p12 en base64
#   IOS_DIST_CERT_PASSWORD        Contraseña del .p12
#   IOS_PROVISIONING_PROFILE_BASE64  Profile (.mobileprovision) en base64
#   KEYCHAIN_PASSWORD             Password efímera para el keychain del runner

require "base64"
require "shellwords"

default_platform(:ios)

PROJECT_ROOT = File.expand_path("..", __dir__)
XCODE_PROJECT = File.join(PROJECT_ROOT, "ios/App/App.xcodeproj")
XCODE_WORKSPACE = File.join(PROJECT_ROOT, "ios/App/App.xcworkspace")
IPA_PATH = File.join(PROJECT_ROOT, "build/HotspotFishing.ipa")
SCHEME = "App"
KEYCHAIN_NAME = "hotspot_fishing_ci.keychain"

platform :ios do
  before_all do
    ENV["MATCH_READONLY"] = "true" if ENV["CI"]
  end

  desc "Importa certificado .p12 y provisioning profile en el runner"
  private_lane :prepare_signing do
    required_env = [
      "APPLE_TEAM_ID",
      "IOS_BUNDLE_ID",
      "APP_STORE_CONNECT_KEY_ID",
      "APP_STORE_CONNECT_ISSUER_ID",
      "APP_STORE_CONNECT_KEY_P8",
      "IOS_DIST_CERT_P12_BASE64",
      "IOS_DIST_CERT_PASSWORD",
      "IOS_PROVISIONING_PROFILE_BASE64",
      "KEYCHAIN_PASSWORD"
    ]
    missing_env = required_env.select { |key| ENV[key].to_s.strip.empty? }
    UI.user_error!("Missing required GitHub Secrets: #{missing_env.join(', ')}") unless missing_env.empty?

    cert_path = "/tmp/dist_cert.p12"
    profile_path = "/tmp/profile.mobileprovision"

    File.write(cert_path, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12_BASE64")))
    File.write(profile_path, Base64.decode64(ENV.fetch("IOS_PROVISIONING_PROFILE_BASE64")))

    create_keychain(
      name: KEYCHAIN_NAME,
      password: ENV.fetch("KEYCHAIN_PASSWORD"),
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )
    UI.message("Using temporary CI keychain: #{KEYCHAIN_NAME}")

    profile_plist_path = "/tmp/profile.plist"
    sh("security cms -D -i #{Shellwords.escape(profile_path)} > #{Shellwords.escape(profile_plist_path)}")
    profile_name = sh("/usr/libexec/PlistBuddy -c 'Print :Name' #{Shellwords.escape(profile_plist_path)}").strip
    profile_uuid = sh("/usr/libexec/PlistBuddy -c 'Print :UUID' #{Shellwords.escape(profile_plist_path)}").strip
    profile_app_id = sh("/usr/libexec/PlistBuddy -c 'Print :Entitlements:application-identifier' #{Shellwords.escape(profile_plist_path)}").strip
    expected_app_id = "#{ENV.fetch("APPLE_TEAM_ID")}.#{ENV.fetch("IOS_BUNDLE_ID")}" 
    UI.message("Provisioning profile: #{profile_name} (#{profile_uuid})")
    UI.message("Provisioning app identifier: #{profile_app_id}")
    UI.user_error!("Provisioning profile bundle id mismatch. Expected #{expected_app_id}, got #{profile_app_id}") unless profile_app_id == expected_app_id
    ENV["IOS_PROVISIONING_PROFILE_NAME"] = profile_name
    ENV["IOS_PROVISIONING_PROFILE_UUID"] = profile_uuid

    import_certificate(
      certificate_path: cert_path,
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: KEYCHAIN_NAME,
      keychain_password: ENV.fetch("KEYCHAIN_PASSWORD")
    )

    keychain_path = File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}-db")
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{Shellwords.escape(ENV.fetch("KEYCHAIN_PASSWORD"))} #{Shellwords.escape(keychain_path)}")
    signing_identities = sh("security find-identity -v -p codesigning #{Shellwords.escape(keychain_path)}")
    UI.message(signing_identities)
    UI.user_error!("The imported .p12 does not contain a valid Apple Distribution signing identity") unless signing_identities.include?("Apple Distribution")

    install_provisioning_profile(path: profile_path)
  end

  desc "Build de la web + sync Capacitor + pod install"
  private_lane :prepare_webview do
    Dir.chdir(PROJECT_ROOT) do
      sh("npm install --ignore-scripts")
      # La app carga una URL remota (server.url en capacitor.config.ts),
      # por lo que no es necesario compilar la web localmente.
      sh("mkdir -p dist && echo '<html><body>Loading...</body></html>' > dist/index.html")
      sh("npx --no-install cap sync ios")
    end
    cocoapods(podfile: File.join(PROJECT_ROOT, "ios/App/Podfile"), repo_update: true)
  end

  desc "Compila .ipa firmado para distribución App Store"
  private_lane :build_ipa do
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODE_PROJECT,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: ENV.fetch("IOS_BUNDLE_ID"),
      sdk: "iphoneos*",
      targets: [SCHEME],
      profile_name: ENV.fetch("IOS_PROVISIONING_PROFILE_NAME"),
      code_sign_identity: "Apple Distribution"
    )

    signing_xcargs = [
      "DEVELOPMENT_TEAM=#{Shellwords.escape(ENV.fetch("APPLE_TEAM_ID"))}",
      "PRODUCT_BUNDLE_IDENTIFIER=#{Shellwords.escape(ENV.fetch("IOS_BUNDLE_ID"))}",
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY=#{Shellwords.escape("Apple Distribution")}",
      "PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(ENV.fetch("IOS_PROVISIONING_PROFILE_NAME"))}"
    ].join(" ")

    increment_build_number(
      xcodeproj: XCODE_PROJECT,
      build_number: ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    )

    build_app(
      workspace: XCODE_WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: File.join(PROJECT_ROOT, "build"),
      output_name: "HotspotFishing.ipa",
      skip_profile_detection: true,
      xcargs: signing_xcargs,
      export_options: {
        method: "app-store",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          ENV.fetch("IOS_BUNDLE_ID") => ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")
        }
      }
    )
  end

  desc "App Store Connect API key (formato fastlane)"
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8").gsub('\\n', "\n"),
      is_key_content_base64: false,
      in_house: false
    )
  end

  # =========================================================
  desc "Compila y sube a TestFlight (canal beta)"
  lane :beta do
    prepare_webview unless ENV["IOS_PROJECT_PREPARED"] == "true"
    prepare_signing
    build_ipa
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: IPA_PATH,
      skip_waiting_for_build_processing: true,
      changelog: ENV["BETA_CHANGELOG"] || "Build automatizada vía GitHub Actions."
    )
  end

  # =========================================================
  desc "Compila y sube a App Store Connect (sin enviar a review)"
  lane :release do
    prepare_webview unless ENV["IOS_PROJECT_PREPARED"] == "true"
    prepare_signing
    build_ipa
    upload_to_app_store(
      api_key: asc_api_key,
      ipa: IPA_PATH,
      skip_metadata: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end

