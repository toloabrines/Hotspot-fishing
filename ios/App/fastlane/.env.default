# Fastlane environment variables
# Copy this file to .env and fill in your values

# Apple credentials
APPLE_ID=your_apple_id@example.com
APPLE_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id
APPLE_ITC_TEAM_ID=your_itc_team_id

# Match configuration (for certificate management)
MATCH_GIT_BASIC_AUTHORIZATION=your_base64_encoded_credentials
MATCH_PASSWORD=your_match_password
MATCH_STORAGE_MODE=git
MATCH_GIT_URL=https://github.com/your_username/your_certificates_repo.git

